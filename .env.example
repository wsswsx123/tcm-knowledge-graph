# docker compose 变量覆盖（复制为 .env 使用）
# 注意：本文件是 compose 编排层变量，与 backend/.env.example 的应用配置变量相互独立。
# 生产部署：所有标注【必填】的项务必修改为强随机值。

# 后端会话密钥【必填】：留空将导致后端拒绝启动（APP_ENV=production）
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# MySQL root 密码【必填】
MYSQL_ROOT_PASSWORD=change_me_mysql_root

# Neo4j 密码【必填】
NEO4J_PASSWORD=change_me_neo4j

# Redis 密码【必填】（会话与限流共用）
REDIS_PASSWORD=change_me_redis

# 管理员引导账号：首次启动自动创建，角色 admin，用于 /admin 后台管理页
ADMIN_USERNAME=admin
# 不设置则生成随机密码并打印到后端启动日志，请登录后尽快修改
ADMIN_PASSWORD=

# Ollama 模型名
OLLAMA_MODEL=qwen2.5:3b
# 任务名 -> 模型名映射（JSON，可选）
# OLLAMA_MODELS={"qwen":"qwen2.5:3b","sunsimiao":"sunsimiao:latest"}

# 是否强制 JWT 登录（生产保持 true；本地演示可设为 false 开箱即用）
AUTH_REQUIRED=true
