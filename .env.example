# docker compose 变量覆盖（复制为 .env 使用）
# 注意：本文件是 compose 编排层变量，与 backend/.env.example 的应用配置变量相互独立。

# 后端会话密钥（生产必填；留空则后端随机生成）
SECRET_KEY=

# MySQL root 密码
MYSQL_ROOT_PASSWORD=root

# Neo4j 密码
NEO4J_PASSWORD=password

# Ollama 模型名
OLLAMA_MODEL=qwen2.5:3b

# 是否强制 JWT 登录（true 时 /api/agents/* 等需登录；默认 false 便于开箱）
AUTH_REQUIRED=false
