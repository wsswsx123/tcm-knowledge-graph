# ===== 运行环境 =====
# development | production | test
APP_ENV=development

# ===== 密钥（生产环境必填，勿使用默认值）=====
SECRET_KEY=

# ===== MySQL =====
DATABASE_URL=mysql+pymysql://root:password@localhost/tcm_health

# ===== Neo4j =====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ===== LLM（Ollama）=====
USE_OLLAMA=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# 本地 Transformers 权重路径（USE_LOCAL_QWEN_FALLBACK=true 时生效）
MODEL_PATH_QWEN=

# ===== 多 Agent =====
CONFIDENCE_THRESHOLD=0.6
TOOL_MAX_RETRIES=3
TOOL_TIMEOUT=15.0
INFERENCE_LATENCY_TARGET=3.0
TOOL_CALLING_MAX_ROUNDS=3
USE_LOCAL_QWEN_FALLBACK=false

# ===== RAG =====
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_TOP_K=3

# ===== MCP =====
MCP_ENABLED=true
MCP_SERVER_CMD=python

# ===== Redis（会话存储 + 高频问答缓存）=====
# 留空时 Session 与问答缓存均回退为进程内内存存储（重启失效，仅适合单机开发）
REDIS_URL=redis://localhost:6379/0
SESSION_TTL=86400

# ===== 高频问答缓存（结果级缓存，命中即跳过三级 Agent 推理）=====
# 仅缓存 stage=plan 且体质置信度 >= QA_CACHE_MIN_CONFIDENCE 的最终方案
QA_CACHE_ENABLED=true
QA_CACHE_TTL=86400
QA_CACHE_MIN_CONFIDENCE=0.9

# ===== Token 成本单价（元 / 1K tokens；本地 Ollama 免费保持 0，云端 API 按定价填写）=====
LLM_PRICE_INPUT_PER_1K=0
LLM_PRICE_OUTPUT_PER_1K=0
