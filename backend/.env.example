# ===== 运行环境 =====
# development | production | test
APP_ENV=development

# ===== 密钥 =====
# APP_ENV=production 时必填，留空将拒绝启动（JWT 跨进程一致）
SECRET_KEY=

# ===== 管理员引导 =====
# 首次启动自动创建该账号（角色 admin），用于 /admin 后台管理页
ADMIN_USERNAME=admin
# 不设置则生成随机密码并打印到启动日志，登录后请尽快修改
ADMIN_PASSWORD=

# ===== MySQL =====
DATABASE_URL=mysql+pymysql://root:password@localhost/tcm_health

# ===== Neo4j =====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ===== LLM（Ollama）=====
USE_OLLAMA=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# 任务名 -> 模型名映射（JSON，可选）：OLLAMA_MODEL_MAP={"qwen":"qwen2.5:3b","sunsimiao":"sunsimiao:latest"}
# 注意：不要用 OLLAMA_MODELS，那是 Ollama 自身的模型目录环境变量
# OLLAMA_MODEL_MAP=
# 本地 Transformers 权重路径（USE_LOCAL_QWEN_FALLBACK=true 时生效）
MODEL_PATH_QWEN=
# 采样温度。线上 0.3 保留自然度；evaluation.py 会自动强制为 0.0（贪心解码），
# 因为非零温度下同一输入两次运行的置信度可差 0.1+，评测结论不可复现。
LLM_TEMPERATURE=0.3

# ===== 多 Agent =====
# 置信度阈值：低于该值触发反问澄清而非直接给结论。
# 0.80 由 scripts/threshold_sweep.py 在 50 例标注集上扫描得出（0.775 是效率拐点，
# 取 0.80 留一点余量）：拒答 8%、已回答幻觉率 6.0%→4.3%。
# 调低会让门控失效（低于 0.664 时一次都不触发），调高会过度拒答。
# 注意：本文件的值会覆盖代码默认值，改完请核对启动日志里的「实际生效阈值」。
CONFIDENCE_THRESHOLD=0.80
TOOL_MAX_RETRIES=3
TOOL_TIMEOUT=15.0
INFERENCE_LATENCY_TARGET=3.0
TOOL_CALLING_MAX_ROUNDS=3
USE_LOCAL_QWEN_FALLBACK=false

# ===== RAG =====
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 向量后端：auto（优先句向量，失败回退 TF-IDF）| sentence-transformer | tfidf
# 离线/CI/无 GPU 环境建议 tfidf；注意不要写成 EMBEDDING_MODEL=tfidf（会被当成模型名解析）
EMBEDDING_BACKEND=auto
RAG_TOP_K=3

# ===== 启动预热 =====
# 重资源（Neo4j 探活 / 向量库 / MCP 子进程）不阻塞 create_app，由后台线程预热
# WARMUP_ENABLED=false 时改为首个请求惰性加载；测试环境默认关闭
WARMUP_ENABLED=true
# false 表示在 create_app 内同步预热（仅脚本/离线任务建议）
WARMUP_ASYNC=true

# ===== 日志 =====
# 异步落盘（QueueHandler/QueueListener）：避免访问日志的同步写盘串行化请求
LOG_ASYNC_ENABLED=true
LOG_LEVEL=INFO

# ===== MCP =====
MCP_ENABLED=true
MCP_SERVER_CMD=python

# ===== 安全 =====
# 是否强制 JWT 鉴权（生产必须 true；本地演示可 false 开箱即用）
AUTH_REQUIRED=false
# CORS 允许来源：* 或逗号分隔的 origin 列表（生产请限定为前端域名）
CORS_ORIGINS=*

# ===== Redis（会话存储 + 限流 + 高频问答缓存）=====
# 留空时回退为进程内内存存储（重启失效，仅适合单机开发）
REDIS_URL=redis://localhost:6379/0
SESSION_TTL=86400

# ===== 高频问答缓存（结果级缓存，命中即跳过三级 Agent 推理）=====
# 仅缓存 stage=plan 且体质置信度 >= QA_CACHE_MIN_CONFIDENCE 的最终方案
QA_CACHE_ENABLED=true
QA_CACHE_TTL=86400
QA_CACHE_MIN_CONFIDENCE=0.9

# ===== Token 成本单价（元 / 1K tokens；本地 Ollama 免费保持 0，云端 API 按定价填写）=====
LLM_PRICE_INPUT_PER_1K=0
LLM_PRICE_OUTPUT_PER_1K=0
