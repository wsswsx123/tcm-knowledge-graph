# ===== 运行环境 =====
# development | production | test
APP_ENV=development

# ===== 密钥（生产环境必填，勿使用默认值）=====
SECRET_KEY=

# ===== MySQL =====
DATABASE_URL=mysql+pymysql://root:password@localhost/tcm_health

# ===== Neo4j =====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ===== LLM（Ollama）=====
USE_OLLAMA=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# 本地 Transformers 权重路径（USE_LOCAL_QWEN_FALLBACK=true 时生效）
MODEL_PATH_QWEN=

# ===== 多 Agent =====
CONFIDENCE_THRESHOLD=0.6
TOOL_MAX_RETRIES=3
TOOL_TIMEOUT=15.0
INFERENCE_LATENCY_TARGET=3.0
TOOL_CALLING_MAX_ROUNDS=3
USE_LOCAL_QWEN_FALLBACK=false

# ===== RAG =====
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_TOP_K=3

# ===== MCP =====
MCP_ENABLED=true
MCP_SERVER_CMD=python
