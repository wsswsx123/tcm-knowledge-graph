{
  "openapi": "3.0.3",
  "info": {
    "title": "中医体质辨识智能诊疗系统 API",
    "description": "基于多 Agent 架构 + 知识图谱 + RAG 的中医体质辨识与养生推荐系统。多 Agent 问诊、知识图谱推荐、RAG 案例匹配、可观测性接口。",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://localhost:5000", "description": "后端（本地/容器）" }
  ],
  "tags": [
    { "name": "observability", "description": "健康检查与指标" },
    { "name": "auth", "description": "用户认证（JWT）" },
    { "name": "agents", "description": "多 Agent 问诊" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["observability"],
        "summary": "存活探针",
        "responses": {
          "200": {
            "description": "服务存活",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": ["observability"],
        "summary": "就绪探针（检查 MySQL / Neo4j / RAG）",
        "responses": {
          "200": { "description": "就绪" },
          "503": { "description": "依赖未就绪（degraded）" }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": ["observability"],
        "summary": "运行时指标（五级容错栈 + 对话/拒答/幻觉抑制统计）",
        "responses": { "200": { "description": "指标快照" } }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": ["auth"],
        "summary": "用户注册（密码 salted 哈希存储，返回 JWT）",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string" },
                  "password": { "type": "string", "minLength": 6 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "注册成功，返回用户与 token",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResult" } } }
          },
          "400": { "description": "参数错误或用户名已存在" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["auth"],
        "summary": "用户登录，返回 JWT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResult" } } }
          },
          "401": { "description": "用户名或密码错误" }
        }
      }
    },
    "/api/auth/user/{user_id}/verify": {
      "get": {
        "tags": ["auth"],
        "summary": "校验用户是否存在",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "user_id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "用户存在" },
          "401": { "description": "用户不存在" }
        }
      }
    },
    "/api/agents/chat": {
      "post": {
        "tags": ["agents"],
        "summary": "多 Agent 多轮问诊主入口（症状→体质→方案，置信度不足则澄清）",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["user_input"],
                "properties": {
                  "user_input": { "type": "string", "maxLength": 1000 },
                  "session_id": { "type": "string" },
                  "sample_id": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "主控 Agent 完整响应（stage / trace / latency / grounding）",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AgentResponse" } } }
          },
          "400": { "description": "user_input 为空或过长" },
          "401": { "description": "未认证（AUTH_REQUIRED=true 时）" }
        }
      }
    },
    "/api/agents/reset": {
      "post": {
        "tags": ["agents"],
        "summary": "重置会话状态",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["session_id"],
                "properties": { "session_id": { "type": "string" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "已重置" } }
      }
    },
    "/api/agents/state/{session_id}": {
      "get": {
        "tags": ["agents"],
        "summary": "查询会话状态（累积症状/轮次/历史）",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "session_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "会话状态" },
          "404": { "description": "会话不存在" }
        }
      }
    },
    "/api/agents/tools": {
      "get": {
        "tags": ["agents"],
        "summary": "列出已注册工具（Function Calling 元信息 + MCP/本地模式）",
        "responses": { "200": { "description": "工具列表" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "ok" },
          "service": { "type": "string", "example": "tcm-knowledge-graph" }
        }
      },
      "AuthResult": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "username": { "type": "string" },
          "token": { "type": "string", "description": "JWT" }
        }
      },
      "AgentResponse": {
        "type": "object",
        "properties": {
          "request_id": { "type": "string" },
          "session_id": { "type": "string" },
          "turn": { "type": "integer" },
          "stage": { "type": "string", "enum": ["clarify", "plan"] },
          "need_more_input": { "type": "boolean" },
          "clarification": { "type": "array", "items": { "type": "string" } },
          "constitution_result": { "type": "object" },
          "plan_result": { "type": "object" },
          "rejected": { "type": "boolean" },
          "latency_sec": { "type": "number" },
          "latency_ok": { "type": "boolean" },
          "grounding": { "type": "object" },
          "trace": { "type": "array", "items": { "type": "object" } }
        }
      }
    }
  }
}
